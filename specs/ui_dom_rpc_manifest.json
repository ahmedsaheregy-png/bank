{
  "manifest_version": "3.0.0",
  "constitutional_ref": "الملف_التقني_للمطورين.md (Sections 1.6, 5.6, 6.2, 6.3, 11.1, D29, D30)",
  "viewports": [
    { "name": "desktop", "width": 1440, "height": 900, "tier": "desktop" },
    { "name": "half_screen_wide", "width": 780, "height": 900, "tier": "rail" },
    { "name": "half_screen_narrow", "width": 680, "height": 900, "tier": "rail" },
    { "name": "mobile", "width": 375, "height": 812, "tier": "mobile" }
  ],
  "forbidden_live_patterns": [
    { "id": "legacy_showcase_link", "pattern": "member-showcase.html", "scope": "web" },
    { "id": "legacy_v1_demo_link", "pattern": "member-demo/index.html", "scope": "web" },
    { "id": "merchant_mock_map", "pattern": "MOCK_MEMBERS_MAP", "scope": "web" },
    { "id": "merchant_hardcoded_gmv", "pattern": "42,800.00", "scope": "web" },
    { "id": "merchant_hardcoded_store_name", "pattern": "سوبرماركت الفارق", "scope": "merchant" },
    { "id": "forbidden_term_cashback_ar", "pattern": "كاشباك", "scope": "web" },
    { "id": "forbidden_term_cashback_space", "pattern": "كاش باك", "scope": "web" },
    { "id": "forbidden_term_bank", "pattern": "SAWYAN BANK", "scope": "web" },
    { "id": "forbidden_term_clawback", "pattern": "-19.75$", "scope": "all" },
    { "id": "forbidden_term_rolling_reserve", "pattern": "Rolling Reserve", "scope": "all" },
    { "id": "forbidden_frozen_totp_active", "pattern": "Offline TOTP Member QR", "scope": "all" }
  ],
  "portals": {
